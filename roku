#!/bin/bash

# RokuCLI v1.2.3
# Repo: https://github.com/skylvie/rokucli
# Source Code License: MIT

VERSION="1.2.3"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
MAGENTA='\033[0;35m'
CYAN='\033[0;36m'
WHITE='\033[1;37m'
GRAY='\033[0;90m'
NC='\033[0m' # No Color

ROKU_IP=""
DEV_MODE_STATUS=""

POWER_STATE_FILE=~/.local/share/rokucli/power_state

check_deps() {
    local missing_deps=()
    
    command -v curl >/dev/null 2>&1 || missing_deps+=("curl")
    
    if [ ${#missing_deps[@]} -ne 0 ]; then
        echo -e "${RED}Error: Missing required dependencies:${NC}"

        for dep in "${missing_deps[@]}"; do
            echo -e "  ${YELLOW}- ${dep}${NC}"
        done

        echo -e "${YELLOW}Please install the missing dependencies and try again${NC}"
        exit 1
    fi
}

show_ascii() {
    local dev_status=$1
    local tv_version=$2
    local device_name=$3
    
    echo -e " _______________"
    echo -e "| /~~~~~~~~\\ ||||  ${YELLOW}RokuCLI ${WHITE}(v${VERSION})${NC}"
    echo -e "||          |...|  ${YELLOW}Device: ${WHITE}${device_name}${NC}"
    echo -e "||          |   |  ${YELLOW}TV Version: ${WHITE}v${tv_version}${NC}"
    echo -e "| \\________/  O |  ${YELLOW}Developer Mode: ${dev_status}${NC}"
    echo -e " ~~~~~~~~~~~~~~~"
}

check_connection() {
    local ip=$1

    if ! curl -s -m 3 "http://${ip}:8060/query/device-info" > /dev/null 2>&1; then
        echo -e "${RED}Failed to connect to RokuTV${NC}"
        exit 1
    fi
}

check_dev_mode() {
    local ip=$1
    local response=$(curl -s -m 5 "http://${ip}:8060/query/apps" 2>&1)
    
    if echo "$response" | grep -q "ECP command not allowed in Limited mode"; then
        echo -e "${RED}Disabled${NC}"
        return 1
    else
        echo -e "${GREEN}Enabled${NC}"
        return 0
    fi
}

roku_get() {
    local endpoint=$1
    local response=$(curl -s -m 5 "http://${ROKU_IP}:8060${endpoint}" 2>&1)
    
    if [ $? -ne 0 ]; then
        echo -e "${RED}Failed to reach device${NC}"
        return 1
    fi
    
    echo "$response"
}

roku_post() {
    local endpoint=$1
    local response=$(curl -s -X POST -m 5 "http://${ROKU_IP}:8060${endpoint}" 2>&1)
    
    if [ $? -ne 0 ]; then
        echo -e "${RED}Failed to reach device${NC}"
        return 1
    fi
    
    echo "$response"
}

cmd_help() {
    echo -e "${MAGENTA}═══════════════════════════════════════════════════════════════${NC}"
    echo -e "${WHITE}Commands:${NC}"
    echo -e "${MAGENTA}═══════════════════════════════════════════════════════════════${NC}"
    {
        echo -e "${YELLOW}help\t${NC}Shows this help message"
        echo -e "${YELLOW}version\t${NC}Shows RokuCLI version"
        echo -e "${YELLOW}connect <ip>\t${NC}Connect to a Roku device"
        echo -e "${YELLOW}update\t${NC}Update RokuCLI"
        echo -e "${YELLOW}clear\t${NC}Clear the screen"
        echo -e "${GREEN}info <key>\t${NC}Get device info for specific key"
        echo -e "${GREEN}info --help\t${NC}Shows all available keys"
        echo -e "${GREEN}info *\t${NC}List all device info values"
        echo -e "${GREEN}keydown <key>\t${NC}Send keydown event"
        echo -e "${GREEN}keyup <key>\t${NC}Send keyup event"
        echo -e "${GREEN}keypress <key>\t${NC}Send keypress event"
        echo -e "${GREEN}keypress --help\t${NC}Shows all available keys"
        echo -e "${GREEN}power\t${NC}Toggle power"
        echo -e "${GREEN}apps\t${NC}List all installed apps"
        echo -e "${GREEN}app\t${NC}Get currently active app"
        echo -e "${GREEN}open <id_or_name> [key=value ...]\t${NC}Launch app by ID or name with optional deeplink parameters"
        echo -e "${GREEN}sideload <path> [password]\t${NC}Upload and sideload app from local zip file"
        echo -e "${GREEN}install <id>\t${NC}Install app from channel store by ID"
        echo -e "${GREEN}browse\t${NC}Open search/browse interface"
        echo -e "${GREEN}search <query>\t${NC}Search for content"
        echo -e "${GREEN}hdmi <number>\t${NC}Switch to HDMI input"
        echo -e "${GREEN}yt <video_id>\t${NC}Open YouTube video"
        echo -e "${GREEN}tv-channels\t${NC}List TV channels"
        echo -e "${GREEN}active-tv-channel\t${NC}Get active TV channel"
    } | column -t -s $'\t'
    echo -e "${MAGENTA}═══════════════════════════════════════════════════════════════${NC}"
}

cmd_version() {
    echo -e "${WHITE}RokuCLI${NC} v${VERSION}"
    echo -e "${BLUE}https://github.com/skylvie/rokucli${NC}"
}

cmd_clear() {
    clear
}

cmd_update() {
    if ! command -v git >/dev/null 2>&1; then
        echo -e "${RED}Error: git is required for updates${NC}"
        return 1
    fi
    
    echo -e "${YELLOW}Updating rokucli...${NC}"

    cd /tmp
    rm -rf rokucli

    git clone https://github.com/skylvie/rokucli > /dev/null 2>&1

    if [ $? -ne 0 ]; then
        echo -e "${RED}Failed to download update${NC}"
        return 1
    fi

    cd rokucli
    chmod +x roku
    sudo cp roku /usr/bin/roku

    if [ $? -ne 0 ]; then
        echo -e "${RED}Failed to install update (need sudo access)${NC}"
        return 1
    fi

    echo -e "${GREEN}RokuCLI updated successfully!${NC}"
    echo -e "${YELLOW}Please restart your session to use the updated version${NC}"
}

cmd_info() {
    local key=$1
    
    local response=$(roku_get "/query/device-info")
    [ $? -ne 0 ] && return 1
    
    if [ "$key" == "--help" ]; then
        echo -e "${CYAN}Available device info keys:${NC}"
        echo "$response" | grep -oP '(?<=<)[^/>]+(?=>)' | grep -v '^/' | sort -u | while read tag; do
            echo -e "  ${YELLOW}${tag}${NC}"
        done
        return
    fi
    
    if [ "$key" == "*" ]; then
        echo -e "${CYAN}Device Information:${NC}"
        echo "$response" | grep -oP '(?<=<)[^>]+(?=>)' | grep -v '^/' | while read line; do
            if [[ ! "$line" =~ [[:space:]] ]]; then
                local value=$(echo "$response" | grep -oP "(?<=<${line}>)[^<]+")
                echo -e "${YELLOW}${line}:${NC} ${WHITE}${value}${NC}"
            fi
        done
    else
        local value=$(echo "$response" | grep -oP "(?<=<${key}>)[^<]+")
        if [ -n "$value" ]; then
            echo -e "${YELLOW}${key}:${NC} ${WHITE}${value}${NC}"
        else
            echo -e "${RED}Key '${key}' not found. Use 'info --help' to see available keys.${NC}"
        fi
    fi
}

cmd_key() {
    local action=$1
    local key=$2
    
    if [ "$key" == "--help" ]; then
        echo -e "${CYAN}Available keys:${NC}"
        echo -e "${YELLOW}Home, Rev, Fwd, Play, Select, Left, Right, Down, Up, Back"
        echo -e "InstantReplay, Info, Backspace, Search, Enter"
        echo -e "VolumeDown, VolumeMute, VolumeUp, PowerOff, PowerOn"
        echo -e "Any other character will be sent as Lit_<character>${NC}"
        return
    fi
    
    # Auto-convert unknown keys to Lit_ format
    local known_keys="Home|Rev|Fwd|Play|Select|Left|Right|Down|Up|Back|InstantReplay|Info|Backspace|Search|Enter|VolumeDown|VolumeMute|VolumeUp|PowerOff|PowerOn"
    
    if [[ ! "$key" =~ ^($known_keys|InputHDMI[0-9]+|Lit_.+)$ ]]; then
        key="Lit_${key}"
    fi
    
    local response=$(roku_post "/${action}/${key}")
    [ $? -ne 0 ] && return 1
    
    echo -e "${GREEN}[v] Sent ${action} ${key}${NC}"
}

cmd_apps() {
    local response=$(roku_get "/query/apps")
    [ $? -ne 0 ] && return 1
    
    echo -e "${CYAN}Installed Apps:${NC}"
    echo "$response" | grep -oP '<app id="\K[^"]+|(?<=>)[^<]+' | paste -d '|' - - | while IFS='|' read id name; do
        local version=$(echo "$response" | grep "id=\"${id}\"" | grep -oP 'version="\K[^"]+')
        echo -e "${YELLOW}- ${name}${NC} | ID: ${MAGENTA}${id}${NC} | Version: ${GRAY}${version}${NC}"
    done
}

cmd_active_app() {
    local response=$(roku_get "/query/active-app")
    [ $? -ne 0 ] && return 1
    
    local app_name=$(echo "$response" | sed -n 's/.*<app[^>]*>\([^<]*\)<\/app>.*/\1/p')
    local app_id=$(echo "$response" | grep -oP 'id="\K[^"]+')
    
    echo -e "${CYAN}Active App:${NC}"
    echo -e "${YELLOW}${app_name}${NC} | ID: ${MAGENTA}${app_id}${NC}"
}

cmd_open() {
    local id_or_name="$1"
    shift
    
    # Parse key=value parameters for deeplinks
    local params=""
    if [ $# -gt 0 ]; then
        local first=true
        for arg in "$@"; do
            if [[ "$arg" =~ ^[^=]+=[^=]+$ ]]; then
                if [ "$first" = true ]; then
                    params="?${arg}"
                    first=false
                else
                    params="${params}&${arg}"
                fi
            fi
        done
    fi

    if [[ "$id_or_name" =~ ^[0-9]+$ ]]; then
        local response=$(roku_post "/launch/${id_or_name}${params}")
        [ $? -ne 0 ] && return 1
        echo -e "${GREEN}[v] Launched app ID: ${id_or_name}${NC}"
    else
        local apps_response=$(roku_get "/query/apps")
        [ $? -ne 0 ] && return 1
        local app_id=$(echo "$apps_response" | grep -i "${id_or_name}" | head -1 | grep -oP 'id="\K[^"]+')
        
        if [ -n "$app_id" ]; then
            local response=$(roku_post "/launch/${app_id}${params}")

            [ $? -ne 0 ] && return 1
            echo -e "${GREEN}[v] Launched ${id_or_name} (ID: ${app_id})${NC}"
        else
            echo -e "${RED}App '${id_or_name}' not found${NC}"
            return 1
        fi
    fi
}

cmd_install() {
    local id=$1
    local response=$(roku_post "/install/${id}")
    [ $? -ne 0 ] && return 1
    echo -e "${GREEN}[v] Installing app ID: ${id}${NC}"
}

cmd_sideload() {
    local path=$1
    local password=$2
    
    if [ -z "$path" ]; then
        echo -e "${RED}Please provide a path to the app package${NC}"
        return 1
    fi
    
    if [ ! -f "$path" ]; then
        echo -e "${RED}File not found: ${path}${NC}"
        return 1
    fi
    
    if [ -z "$password" ]; then
        read -s -p "$(echo -e ${YELLOW}Password: ${NC})" password
        echo
    fi
    
    echo -e "${YELLOW}Uploading app package...${NC}"
    
    local response=$(curl -s -w "\n%{http_code}" \
        --digest --user "rokudev:${password}" \
        -F "mysubmit=Install" \
        -F "archive=@${path}" \
        "http://${ROKU_IP}/plugin_install" 2>&1)
    
    local http_code=$(echo "$response" | tail -n 1)
    local body=$(echo "$response" | sed '$d')
    
    if [ "$http_code" == "200" ]; then
        echo -e "${GREEN}[v] Successfully uploaded app!${NC}"
        return 0
    elif [ "$http_code" == "401" ]; then
        echo -e "${RED}Unable to authenticate ${NC}"
        return 1
    else
        echo -e "${RED}Error: Upload failed (HTTP ${http_code})${NC}"
        [ -n "$body" ] && echo -e "${GRAY}${body}${NC}"
        return 1
    fi
}

cmd_browse() {
    local response=$(roku_post "/search/browse")
    [ $? -ne 0 ] && return 1
    echo -e "${GREEN}[v] Opened browse interface${NC}"
}

cmd_search() {
    local query=$1
    local encoded_query=$(echo "$query" | sed 's/ /%20/g')
    local response=$(roku_post "/search/keyword?keyword=${encoded_query}")
    [ $? -ne 0 ] && return 1
    echo -e "${GREEN}[v] Searching for: ${query}${NC}"
}

cmd_hdmi() {
    local number=$1
    local response=$(roku_post "/keypress/InputHDMI${number}")
    [ $? -ne 0 ] && return 1
    
    echo -e "${GREEN}[v] Switched to HDMI ${number}${NC}"
}

cmd_yt() {
    local video_id=$1
    
    if [ -z "$video_id" ]; then
        echo -e "${RED}Please provide a YouTube video ID${NC}"
        return 1
    fi
    
    local apps_response=$(roku_get "/query/apps")
    [ $? -ne 0 ] && return 1
    
    local youtube_id=$(echo "$apps_response" | grep -i "YouTube" | head -1 | grep -oP 'id="\K[^"]+' )
    if [ -z "$youtube_id" ]; then
        echo -e "${RED}YouTube app not found on this Roku${NC}"
        return 1
    fi
    
    local response=$(roku_post "/launch/${youtube_id}?contentID=${video_id}&mediaType=video")
    [ $? -ne 0 ] && return 1
    
    echo -e "${GREEN}[v] Opening YouTube video: ${video_id}${NC}"
}

cmd_tv_channels() {
    local response=$(roku_get "/query/tv-channels")
    [ $? -ne 0 ] && return 1
    
    echo -e "${CYAN}TV Channels:${NC}"
    echo "$response" | grep -oP '<channel id="\K[^"]+|number="\K[^"]+|(?<=<name>)[^<]+' | \
        paste -d '|' - - - | while IFS='|' read id number name; do
        echo -e "${YELLOW}${number}. ${name}${NC} | ID: ${MAGENTA}${id}${NC}"
    done
}

cmd_active_tv_channel() {
    local response=$(roku_get "/query/active-tv-channel")
    [ $? -ne 0 ] && return 1
    
    local channel_name=$(echo "$response" | grep -oP '(?<=<name>)[^<]+')
    local channel_number=$(echo "$response" | grep -oP 'number="\K[^"]+')
    
    echo -e "${CYAN}Active TV Channel:${NC}"
    echo -e "${YELLOW}${channel_number}. ${channel_name}${NC}"
}

cmd_power() {
    # Track power state
    local state_file="${POWER_STATE_FILE/#\~/$HOME}"
    local current_state="off"
    
    mkdir -p "$(dirname "$state_file")"
    
    if [ -f "$state_file" ]; then
        current_state=$(cat "$state_file")
    fi
    
    if [ "$current_state" == "on" ]; then
        cmd_key "keypress" "PowerOff"
        echo "off" > "$state_file"
    else
        cmd_key "keypress" "PowerOn"
        echo "on" > "$state_file"
    fi
}

cmd_connect() {
    local ip=$1
    
    if [ -z "$ip" ]; then
        echo -e "${RED}Please provide an IP address${NC}"
        return 1
    fi
    
    check_deps
    check_connection "$ip"
    
    if [ $? -eq 0 ]; then
        ROKU_IP=$ip
        echo -e "${GREEN}[v] Connected to ${ip}${NC}"
        
        local device_info=$(roku_get "/query/device-info")
        local device_name=$(echo "$device_info" | grep -oP '(?<=<friendly-device-name>)[^<]+' || echo "Roku Device")
        echo -e "${CYAN}Device: ${WHITE}${device_name}${NC}"
    fi
}

process_command() {
    local cmd=$1
    shift
    
    case "$cmd" in
        # Commands that don't require device connection
        help)
            cmd_help
            ;;
        version)
            cmd_version
            ;;
        update)
            cmd_update
            ;;
        connect)
            cmd_connect "$@"
            ;;
        clear)
            cmd_clear
            ;;
        # Commands that require device connection
        info)
            if [ -z "$ROKU_IP" ]; then
                echo -e "${RED}Not connected to a device, use 'connect <ip>' command first${NC}"
                return 1
            fi
            cmd_info "$@"
            ;;
        keydown|keyup|keypress)
            if [ -z "$ROKU_IP" ]; then
                echo -e "${RED}Not connected to a device, use 'connect <ip>' command first${NC}"
                return 1
            fi
            cmd_key "$cmd" "$@"
            ;;
        power)
            if [ -z "$ROKU_IP" ]; then
                echo -e "${RED}Not connected to a device, use the 'connect <ip>' command first${NC}"
                return 1
            fi

            cmd_power
            ;;
        apps)
            if [ -z "$ROKU_IP" ]; then
                echo -e "${RED}Not connected to a device, use the 'connect <ip>' command first${NC}"
                return 1
            fi

            cmd_apps
            ;;
        app)
            if [ -z "$ROKU_IP" ]; then
                echo -e "${RED}Not connected to a device, use the 'connect <ip>' command first${NC}"
                return 1
            fi

            cmd_active_app
            ;;
        open)
            if [ -z "$ROKU_IP" ]; then
                echo -e "${RED}Not connected to a device, use the 'connect <ip>' command first${NC}"
                return 1
            fi

            cmd_open "$@"
            ;;
        sideload)
            if [ -z "$ROKU_IP" ]; then
                echo -e "${RED}Not connected to a device, use the 'connect <ip>' command first${NC}"
                return 1
            fi

            cmd_sideload "$@"
            ;;
        install)
            if [ -z "$ROKU_IP" ]; then
                echo -e "${RED}Not connected to a device, use the 'connect <ip>' command first${NC}"
                return 1
            fi

            cmd_install "$@"
            ;;
        browse)
            if [ -z "$ROKU_IP" ]; then
                echo -e "${RED}Not connected to a device, use the 'connect <ip>' command first${NC}"
                return 1
            fi

            cmd_browse
            ;;
        search)
            if [ -z "$ROKU_IP" ]; then
                echo -e "${RED}Not connected to a device, use the 'connect <ip>' command first${NC}"
                return 1
            fi

            cmd_search "$@"
            ;;
        hdmi)
            if [ -z "$ROKU_IP" ]; then
                echo -e "${RED}Not connected to a device, use the 'connect <ip>' command first${NC}"
                return 1
            fi

            cmd_hdmi "$@"
            ;;
        yt)
            if [ -z "$ROKU_IP" ]; then
                echo -e "${RED}Not connected to a device, use the 'connect <ip>' command first${NC}"
                return 1
            fi

            cmd_yt "$@"
            ;;
        tv-channels)
            if [ -z "$ROKU_IP" ]; then
                echo -e "${RED}Not connected to a device, use the 'connect <ip>' command first${NC}"
                return 1
            fi

            cmd_tv_channels
            ;;
        active-tv-channel)
            if [ -z "$ROKU_IP" ]; then
                echo -e "${RED}Not connected to a device, use the 'connect <ip>' command first${NC}"
                return 1
            fi

            cmd_active_tv_channel
            ;;
        exit|quit)
            exit 0
            ;;
        "")
            ;;
        *)
            echo -e "${RED}Command not found${NC}"
            ;;
    esac
}

interactive_mode() {
    history -c
    HISTFILE=~/.local/share/rokucli/history

    mkdir -p ~/.local/share/rokucli
    
    while true; do
        read -e -r -p "$(echo -e ${GREEN}Command: ${NC})" input
        [ -z "$input" ] && continue

        history -s "$input"
        read -ra parts <<< "$input" 

        process_command "${parts[@]}"
    done
}

main() {
    if [ $# -gt 0 ] && [[ "$1" == --* ]]; then
        case "$1" in
            --help)
                cmd_help
                exit 0
                ;;
            --version)
                cmd_version
                exit 0
                ;;
            --update)
                cmd_update
                exit 0
                ;;
        esac
    fi

    if [ $# -eq 0 ]; then
        echo -e "${RED}Usage: roku <ip> [options]${NC}"
        echo ""
        echo -e "${YELLOW}Options:${NC}"
        echo -e "  ${GREEN}--help${NC}                    Show help message"
        echo -e "  ${GREEN}--version${NC}                 Show version info"
        echo -e "  ${GREEN}--update${NC}                  Update RokuCLI"
        exit 1
    fi
    
    local first_arg=$1

    if [[ "$first_arg" == --* ]]; then
        echo -e "${RED}Unknown flag: ${first_arg}${NC}"
        echo -e "${YELLOW}IP address is required for device commands${NC}"
        exit 1
    fi
    
    ROKU_IP=$first_arg
    shift

    check_deps
    check_connection "$ROKU_IP"

    if [ $# -gt 0 ]; then
        local flag=$1
        shift
        
        case "$flag" in
            --help)
                cmd_help
                ;;
            --version)
                cmd_version
                ;;
            --update)
                cmd_update
                ;;
            --info)
                cmd_info "$@"
                ;;
            --keypress)
                cmd_key "keypress" "$@"
                ;;
            --keydown)
                cmd_key "keydown" "$@"
                ;;
            --keyup)
                cmd_key "keyup" "$@"
                ;;
            --power)
                cmd_power
                ;;
            --apps)
                cmd_apps
                ;;
            --app)
                cmd_active_app
                ;;
            --open)
                cmd_open "$@"
                ;;
            --sideload)
                local pwd_arg=""
                if [ "$1" == "--pwd" ]; then
                    shift
                    pwd_arg="$1"
                    shift
                fi
                cmd_sideload "$1" "$pwd_arg"
                ;;
            --install)
                cmd_install "$@"
                ;;
            --browse)
                cmd_browse
                ;;
            --search)
                cmd_search "$@"
                ;;
            --hdmi)
                cmd_hdmi "$@"
                ;;
            --yt)
                cmd_yt "$@"
                ;;
            --tv-channels)
                cmd_tv_channels
                ;;
            --active-tv-channel)
                cmd_active_tv_channel
                ;;
            *)
                echo -e "${RED}Unknown flag: ${flag}${NC}"
                exit 1
                ;;
        esac
    else
        DEV_MODE_STATUS=$(check_dev_mode "$ROKU_IP")

        local device_info=$(roku_get "/query/device-info")
        local tv_version=$(echo "$device_info" | grep -oP '(?<=<software-version>)[^<]+' || echo "XX.XX.XX")
        local device_name=$(echo "$device_info" | grep -oP '(?<=<friendly-device-name>)[^<]+' || echo "Roku Device")
        
        show_ascii "$DEV_MODE_STATUS" "$tv_version" "$device_name"
        interactive_mode
    fi
}

main "$@"
